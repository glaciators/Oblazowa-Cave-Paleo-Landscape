    <Style id="present-day-normal">
      <IconStyle>
        <color>d9ffffff</color>
        <scale>0.85</scale>
        <Icon><href>https://glaciators.github.io/Oblazowa-Cave-Paleo-Landscape/img/kml-link-green.png</href></Icon>
      <hotSpot x="0.5" y="0.5" xunits="fraction" yunits="fraction"/></IconStyle>
      <LineStyle><color>bf2ca02c</color><width>2</width></LineStyle>
      <LabelStyle><scale>0</scale></LabelStyle>
    </Style>
    <Style id="present-day-highlight">
      <IconStyle>
        <color>d9ffffff</color>
        <scale>1.05</scale>
        <Icon><href>https://glaciators.github.io/Oblazowa-Cave-Paleo-Landscape/img/kml-link-green.png</href></Icon>
      <hotSpot x="0.5" y="0.5" xunits="fraction" yunits="fraction"/></IconStyle>
      <LineStyle><color>bf2ca02c</color><width>2</width></LineStyle>
      <LabelStyle><scale>1</scale></LabelStyle>
    </Style>
    <StyleMap id="present-day">
      <Pair><key>normal</key><styleUrl>#present-day-normal</styleUrl></Pair>
      <Pair><key>highlight</key><styleUrl>#present-day-highlight</styleUrl></Pair>
    </StyleMap>

